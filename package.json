{
  "name": "meowtower",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "lint": "eslint . && tsx tools/static-checks.ts",
    "verify:templates": "tsx tools/verify-templates.ts",
    "verify:live": "GATEWAY_MODE=verify tsx tools/verify-live.ts",
    "format": "prettier --check .",
    "test": "vitest run tests && playwright test",
    "test:smoke": "vitest run tests/smoke",
    "start": "node dist/server/main.js",
    "strings:system": "tsx tools/strings-system.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@duckdb/node-api": "1.5.5-r.5",
    "@hono/node-server": "2.1.1",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.9",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "eslint-plugin-i18next": "6.1.5",
    "fast-check": "4.10.2",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2"
  }
}
