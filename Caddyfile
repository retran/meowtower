{
	# Unprivileged ports inside the container; the Mac publishes 443.
	http_port 8080
	https_port 8443
	auto_https disable_redirects
	admin off
}

https://{$MEOWTOWER_HOST}, https://localhost {
	tls internal
	# The one-time iPad profile (./meowtower ipad-setup); it holds only the public root certificate.
	handle_path /setup/* {
		root * /srv/setup
		header Content-Type application/x-apple-aspen-config
		file_server
	}
	reverse_proxy meowtower:3000
}
