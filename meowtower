#!/usr/bin/env bash
# The one operator command on the Mac (SPC-0010, names from ADR-0200). Each task adds the
# subcommands it needs; these are up, down, status, ipad-setup, set-home-network, watch, pair, db-snapshot, restore and export.
set -euo pipefail
cd "$(dirname "$0")"

CAFFEINATE_PID=data/.caffeinate.pid

host_name() { echo "$(scutil --get LocalHostName 2>/dev/null || hostname -s).local"; }
mac_time_zone() { readlink /etc/localtime | sed 's#.*/zoneinfo/##'; }
docker_running() { docker info >/dev/null 2>&1; }

compose() {
  MEOWTOWER_HOST="$(host_name)" TZ="$(mac_time_zone)" MEOWTOWER_PARENT_PORT="${MEOWTOWER_PARENT_PORT:-8080}" \
    docker compose "$@"
}

ROOT_CERT="${MEOWTOWER_ROOT_CERT:-data/caddy/caddy/pki/authorities/local/root.crt}"

# A configuration profile that installs Caddy's root certificate, so the
# iPad trusts https://<mac-name>.local after this one-time setup (REQ-2514).
profile() {
  if [[ ! -f $ROOT_CERT ]]; then
    echo "root_certificate_missing: run ./meowtower up once so Caddy creates its authority."
    return 1
  fi
  local der uuid1 uuid2
  der="$(openssl x509 -in "$ROOT_CERT" -outform DER | base64 | fold -w 52)"
  uuid1="$(uuidgen)"; uuid2="$(uuidgen)"
  cat <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadCertificateFileName</key>
			<string>meowtower-root.cer</string>
			<key>PayloadContent</key>
			<data>
$der
			</data>
			<key>PayloadDisplayName</key>
			<string>Meowtower local authority</string>
			<key>PayloadIdentifier</key>
			<string>local.meowtower.root.$uuid1</string>
			<key>PayloadType</key>
			<string>com.apple.security.root</string>
			<key>PayloadUUID</key>
			<string>$uuid1</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
		</dict>
	</array>
	<key>PayloadDisplayName</key>
	<string>Meowtower</string>
	<key>PayloadIdentifier</key>
	<string>local.meowtower.profile</string>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadUUID</key>
	<string>$uuid2</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
</dict>
</plist>
PLIST
}

cmd_ipad_setup() {
  if [[ ${1:-} == --print-profile ]]; then profile; return; fi
  mkdir -p data/setup
  profile > data/setup/meowtower.mobileconfig.new \
    || { cat data/setup/meowtower.mobileconfig.new; rm -f data/setup/meowtower.mobileconfig.new; exit 1; }
  mv data/setup/meowtower.mobileconfig.new data/setup/meowtower.mobileconfig
  local url="https://$(host_name)/setup/meowtower.mobileconfig"
  echo "On the iPad, once per device:"
  echo "  1. Open $url in Safari. It warns once that the connection isn't private:"
  echo "     tap Show Details, then visit the website, and allow the download."
  echo "  2. Settings > Profile Downloaded > Install."
  echo "  3. Settings > General > About > Certificate Trust Settings > turn on Meowtower local authority."
  echo "  4. Open https://$(host_name) in Safari: no warning now. Share > Add to Home Screen."
  echo "  5. Open the home-screen app and pair inside it, because it keeps its own storage."
  if command -v qrencode >/dev/null; then qrencode -t ansiutf8 "$url"; fi
}

HOME_GATEWAY_FILE="${MEOWTOWER_HOME_GATEWAY_FILE:-data/home-gateway}"

# The router's hardware address for `ip`, or `unknown` when the ARP table has none.
arp_mac() {
  local mac
  mac="$(arp -n "$1" 2>/dev/null | awk '{print $4}' || true)"
  [[ $mac =~ ^[0-9a-f:]+$ ]] && echo "$mac" || echo unknown
}

# The current default gateway, as "IP hardware-address", or "IP unknown" when
# the Mac can't read the router's hardware address. A router's ARP entry often
# lapses after a reboot or a long sleep, so a read that misses is followed by a
# ping and a second read; `--ping` pings before the first read (REQ-2510).
gateway_id() {
  if [[ -n ${MEOWTOWER_GATEWAY_ID:-} ]]; then echo "$MEOWTOWER_GATEWAY_ID"; return; fi
  local ip mac
  ip="$(route -n get default 2>/dev/null | awk '/gateway:/{print $2}' || true)"
  if [[ -z $ip ]]; then echo "none unknown"; return; fi
  if [[ ${1:-} == --ping ]]; then ping -c 1 -t 2 "$ip" >/dev/null 2>&1 || true; fi
  mac="$(arp_mac "$ip")"
  if [[ $mac == unknown && ${1:-} != --ping ]]; then
    ping -c 1 -t 2 "$ip" >/dev/null 2>&1 || true
    mac="$(arp_mac "$ip")"
  fi
  echo "$ip $mac"
}

# Pings the gateway so the ARP table holds it, then records it. A gateway that
# doesn't answer records nothing and keeps the old record (REQ-2510).
cmd_set_home_network() {
  mkdir -p "$(dirname "$HOME_GATEWAY_FILE")"
  local id
  id="$(gateway_id --ping)"
  if [[ ${id#* } == unknown ]]; then
    echo "gateway_unverified: the router's hardware address can't be read from here, so nothing was recorded."
    echo "At home, with the router on, run ./meowtower set-home-network again."
    exit 1
  fi
  echo "$id" > "$HOME_GATEWAY_FILE"
  echo "Home network recorded: $(cat "$HOME_GATEWAY_FILE")"
}

# What the recorded and the current gateway say: ok, wrong_network (the IP
# address differs, or it matches and the hardware address differs) or
# gateway_unverified (either hardware address is unknown).
network_state() {
  local recorded=$1 current=$2
  local r_ip=${recorded% *} r_mac=${recorded#* } c_ip=${current% *} c_mac=${current#* }
  if [[ $r_ip != "$c_ip" ]]; then echo wrong_network
  elif [[ $r_mac == unknown || $c_mac == unknown ]]; then echo gateway_unverified
  elif [[ $r_mac != "$c_mac" ]]; then echo wrong_network
  else echo ok
  fi
}

# REQ-2510: start only on the home network. The first up records it.
check_home_network() {
  local current recorded state
  current="$(gateway_id)"
  if [[ ! -s $HOME_GATEWAY_FILE ]]; then cmd_set_home_network; return; fi
  recorded="$(cat "$HOME_GATEWAY_FILE")"
  state="$(network_state "$recorded" "$current")"
  if [[ $state == wrong_network ]]; then
    echo "wrong_network: this isn't the home network (recorded gateway $recorded, current $current)."
    echo "Nothing started. After changing routers, run ./meowtower set-home-network at home."
    exit 1
  fi
  if [[ $state == gateway_unverified ]]; then
    echo "gateway_unverified: the router's hardware address is unknown (recorded gateway $recorded, current $current)."
    echo "Nothing started. At home, with the router on, run ./meowtower set-home-network."
    exit 1
  fi
}

NOTICES_FILE=data/snapshots/notices.json

# Removes the `wrong_network` key from the notices the server keeps beside the
# snapshots, so a start on the home network clears it.
clear_wrong_network_notice() {
  [[ -s $NOTICES_FILE ]] || return 0
  local body
  body="$(sed -E 's/"wrong_network":\{[^}]*\},?//; s/,\}/}/' "$NOTICES_FILE")"
  printf '%s\n' "$body" > "$NOTICES_FILE"
}

# Adds `wrong_network` with the recorded and the current gateway to the notices.
write_wrong_network_notice() {
  mkdir -p "$(dirname "$NOTICES_FILE")"
  local notice body
  notice="\"wrong_network\":{\"at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\",\"recorded\":\"$1\",\"current\":\"$2\"}"
  if [[ -s $NOTICES_FILE ]]; then
    body="$(sed -E 's/"wrong_network":\{[^}]*\},?//; s/,\}/}/' "$NOTICES_FILE")"
  else
    body="{}"
  fi
  if [[ $body == "{}" ]]; then
    printf '{%s}\n' "$notice" > "$NOTICES_FILE"
  else
    printf '%s\n' "$body" | sed "s/^{/{$notice,/" > "$NOTICES_FILE"
  fi
}

# The network watch: one tick compares the gateway, pinging it before the read,
# and stops both containers while they run when it differs from the record or
# can't be verified (REQ-2510).
watch_tick() {
  [[ -s $HOME_GATEWAY_FILE ]] || return 0
  docker_running || return 0
  local recorded current state
  recorded="$(cat "$HOME_GATEWAY_FILE")"
  current="$(gateway_id --ping)"
  state="$(network_state "$recorded" "$current")"
  [[ $state == ok ]] && return 0
  # Nothing further to stop while the containers are down.
  compose ps --format '{{.Name}}' 2>/dev/null | grep -q . || return 0
  compose stop >/dev/null 2>&1 || true
  write_wrong_network_notice "$recorded" "$current"
}

# Ticks at once and then every 60 seconds; `--once` ends after the first tick.
cmd_watch() {
  local once=0 limit="${MEOWTOWER_WATCH_TICKS:-0}" nap="${MEOWTOWER_WATCH_SLEEP:-60}" n=0
  [[ ${1:-} == --once ]] && once=1
  while true; do
    watch_tick || true
    n=$((n + 1))
    (( once )) && return 0
    (( limit > 0 && n >= limit )) && return 0
    sleep "$nap"
  done
}

WATCH_LABEL=local.meowtower.watch
LAUNCH_AGENTS="${MEOWTOWER_LAUNCH_AGENTS:-$HOME/Library/LaunchAgents}"
WATCH_PLIST="$LAUNCH_AGENTS/$WATCH_LABEL.plist"

# The launchd agent runs in the parent's user session, because `docker` needs
# that user's context, and loads again at her login (RunAtLoad).
load_watch() {
  mkdir -p "$LAUNCH_AGENTS" data
  cat > "$WATCH_PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>$WATCH_LABEL</string>
	<key>ProgramArguments</key>
	<array>
		<string>$PWD/meowtower</string>
		<string>watch</string>
	</array>
	<key>WorkingDirectory</key>
	<string>$PWD</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>PATH</key>
		<string>$PATH</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>$PWD/data/watch.log</string>
	<key>StandardErrorPath</key>
	<string>$PWD/data/watch.log</string>
</dict>
</plist>
PLIST
  launchctl unload "$WATCH_PLIST" >/dev/null 2>&1 || true
  launchctl load -w "$WATCH_PLIST"
}

unload_watch() {
  if [[ -f $WATCH_PLIST ]]; then
    launchctl unload -w "$WATCH_PLIST" >/dev/null 2>&1 || true
    rm -f "$WATCH_PLIST"
  fi
}

# The same setting Compose reads from .env.
if [[ -z ${MEOWTOWER_PARENT_PORT:-} && -f .env ]]; then
  MEOWTOWER_PARENT_PORT="$(sed -n 's/^MEOWTOWER_PARENT_PORT=//p' .env | tail -1)"
fi
PARENT_PORT="${MEOWTOWER_PARENT_PORT:-8080}"

# The Parent Room's loopback port must be free, or it would silently not bind.
check_parent_port() {
  if compose ps --format '{{.Name}}' 2>/dev/null | grep -q meowtower-meowtower; then return; fi
  if lsof -nP -iTCP:"$PARENT_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    echo "port_in_use: port $PARENT_PORT is taken, so the Parent Room can't listen there."
    echo "Nothing started. Set MEOWTOWER_PARENT_PORT to a free port, for example in .env."
    exit 1
  fi
}

# A 6-digit pairing code that lives 5 minutes, issued through the Parent
# Room's listener, which only this Mac can reach (REQ-2516).
cmd_pair() {
  local reply code
  reply="$(curl -fsS -X POST "http://localhost:$PARENT_PORT/pair-code")" \
    || { echo "server_unreachable: run ./meowtower up first."; exit 1; }
  code="$(echo "$reply" | sed -n 's/.*"code":"\([0-9]\{6\}\)".*/\1/p')"
  echo "Pairing code: $code"
  echo "Enter it on the device within 5 minutes. It works once."
}

# The Parent Room PIN, 4 to 8 digits, read twice without echo and sent over
# the Parent Room's listener, which only this Mac can reach (SPC-0010).
cmd_set_pin() {
  local pin again status
  read -rs -p "New Parent Room PIN (4 to 8 digits): " pin; echo
  read -rs -p "The same PIN again: " again; echo
  [[ "$pin" == "$again" ]] || { echo "pin_mismatch: the two entries differ."; exit 1; }
  [[ "$pin" =~ ^[0-9]{4,8}$ ]] || { echo "pin_format: use 4 to 8 digits."; exit 1; }
  # On stdin, so the PIN never shows in the process list.
  status="$(printf '{"pin":"%s"}' "$pin" | curl -sS -o /dev/null -w '%{http_code}' \
    -X POST -H 'content-type: application/json' --data @- \
    "http://localhost:$PARENT_PORT/pin")" \
    || { echo "server_unreachable: run ./meowtower up first."; exit 1; }
  [[ "$status" == "200" ]] || { echo "pin_not_set: the server answered $status."; exit 1; }
  echo "The Parent Room PIN is set."
}

# A full recompute of every projection, run by the server through the Parent
# Room's listener while play goes on (SPC-0020).
cmd_recompute() {
  local reply
  reply="$(curl -sS -X POST "http://localhost:$PARENT_PORT/recompute")" \
    || { echo "server_unreachable: run ./meowtower up first."; exit 1; }
  if [[ "$reply" == *'"error"'* ]]; then
    echo "recompute_failed: $reply"; exit 1
  fi
  echo "Recomputed: $(echo "$reply" | sed -n 's/.*"tables":\[\([^]]*\)\].*/\1/p' | tr -d '"' | sed 's/,/, /g')"
  echo "Up to event $(echo "$reply" | sed -n 's/.*"lastSeq":\([0-9]*\).*/\1/p'), in $(echo "$reply" | sed -n 's/.*"ms":\([0-9]*\).*/\1/p') ms."
}

# One snapshot on demand, taken by the server so play goes on (SPC-0010).
cmd_db_snapshot() {
  local reply
  reply="$(curl -fsS -X POST "http://localhost:$PARENT_PORT/snapshot")" \
    || { echo "backup_failed: the server took no snapshot; is it up?"; exit 1; }
  echo "Snapshot: $(echo "$reply" | sed -n 's/.*"file":"[^"]*\/\([^"]*\)".*/\1/p') in $(echo "$reply" | sed -n 's/.*"ms":\([0-9]*\).*/\1/p') ms"
}

# The live database becomes the newest snapshot. Play stops while it runs.
cmd_restore() {
  compose stop meowtower
  compose run --rm --no-deps meowtower node dist/server/restore.js
  compose start meowtower
}

# The export, run by the server from a fresh copy (REQ-2238): the raw log,
# the flat tables and the field dictionary under data/exports/<UTC time>/.
cmd_export() {
  local reply
  reply="$(curl -fsS -X POST "http://localhost:$PARENT_PORT/api/parent/export")" \
    || { echo "export_failed: the server wrote no export; is it up?"; exit 1; }
  echo "Export written to data/exports/$(echo "$reply" | sed -n 's/.*"dir":"[^"]*\/\([^"/]*\)".*/\1/p')/"
}

cmd_up() {
  check_home_network
  if ! docker_running; then echo "docker_not_running: Docker isn't running (Docker Desktop or OrbStack)."; exit 1; fi
  check_parent_port
  mkdir -p data/blobs data/snapshots data/exports data/caddy data/setup
  clear_wrong_network_notice
  compose up -d --build
  # Caddy reads its bind-mounted Caddyfile only at start, so apply any change.
  compose restart proxy >/dev/null
  # Keep the Mac awake while the server runs.
  if [[ ! -f $CAFFEINATE_PID ]] || ! kill -0 "$(cat $CAFFEINATE_PID)" 2>/dev/null; then
    # Detach it fully, or the script waits on its output and never returns.
    nohup caffeinate -ims >/dev/null 2>&1 &
    echo $! > "$CAFFEINATE_PID"
  fi
  load_watch
  local url="https://$(host_name)"
  echo "Meowtower is up at $url; the Parent Room is at http://localhost:$PARENT_PORT on this Mac"
  if command -v qrencode >/dev/null; then qrencode -t ansiutf8 "$url"; fi
}

cmd_down() {
  unload_watch
  # Never pass -v: the volume meowtower-db holds the live database.
  if docker_running; then compose down; fi
  if [[ -f $CAFFEINATE_PID ]]; then
    kill "$(cat $CAFFEINATE_PID)" 2>/dev/null || true
    rm -f "$CAFFEINATE_PID"
  fi
}

cmd_status() {
  if ! docker_running; then echo "docker_not_running: Docker isn't running (Docker Desktop or OrbStack)."; exit 1; fi
  echo "Docker: running"
  for svc in meowtower proxy; do
    local state
    state="$(compose ps --format '{{.State}}' "$svc" 2>/dev/null | head -1)"
    echo "$svc: ${state:-not running}"
  done
  if [[ -f data/snapshots/last.json ]]; then
    echo "last snapshot: $(sed -n 's/.*"at":"\([^"]*\)".*/\1/p' data/snapshots/last.json), took $(sed -n 's/.*"ms":\([0-9]*\).*/\1/p' data/snapshots/last.json) ms"
  else
    echo "last snapshot: none yet"
  fi
  # The parent's notices, written by the server beside the snapshots (SPC-0010).
  if [[ -f data/snapshots/notices.json ]]; then
    local failed ceiling
    failed="$(sed -n 's/.*"backup_failed":{"at":"\([^"]*\)".*/\1/p' data/snapshots/notices.json)"
    ceiling="$(sed -n 's/.*"storage_ceiling":{"at":"[^"]*","gb":\([0-9]*\)}.*/\1/p' data/snapshots/notices.json)"
    [[ -n "$failed" ]] && echo "backup_failed: the snapshot at $failed failed; the next good one clears this."
    [[ -n "$ceiling" ]] && echo "storage_ceiling: data/ and the database hold more than $ceiling GB."
    local rfailed rslow large
    rfailed="$(sed -n 's/.*"recompute_failed":{"at":"\([^"]*\)","version":"\([^"]*\)".*/\1 (\2)/p' data/snapshots/notices.json)"
    rslow="$(sed -n 's/.*"recompute_slow":{"at":"[^"]*","ms":\([0-9]*\)}.*/\1/p' data/snapshots/notices.json)"
    large="$(sed -n 's/.*"log_large":{"at":"\([^"]*\)".*/\1/p' data/snapshots/notices.json)"
    [[ -n "$rfailed" ]] && echo "recompute_failed: the recompute at $rfailed failed; the old projections stay."
    [[ -n "$rslow" ]] && echo "recompute_slow: a full recompute took $rslow ms, over the 60 s budget."
    [[ -n "$large" ]] && echo "log_large: the event log passed 1 GB."
    local wfailed
    wfailed="$(sed -n 's/.*"log_write_failed":{"at":"\([^"]*\)".*/\1/p' data/snapshots/notices.json)"
    [[ -n "$wfailed" ]] && echo "log_write_failed: a write to the event log failed at $wfailed; check the free space on the Mac."
    local wrong_r wrong_c
    wrong_r="$(sed -n 's/.*"wrong_network":{"at":"[^"]*","recorded":"\([^"]*\)".*/\1/p' data/snapshots/notices.json)"
    wrong_c="$(sed -n 's/.*"wrong_network":{"at":"[^"]*","recorded":"[^"]*","current":"\([^"]*\)".*/\1/p' data/snapshots/notices.json)"
    [[ -n "$wrong_r" ]] && echo "wrong_network: the containers were stopped because the gateway changed (recorded $wrong_r, current $wrong_c). Run ./meowtower set-home-network at home after changing routers, or ./meowtower up on the home network."
  fi
  return 0
}

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  ipad-setup) shift; cmd_ipad_setup "$@" ;;
  set-home-network) cmd_set_home_network ;;
  watch) shift; cmd_watch "$@" ;;
  pair) cmd_pair ;;
  set-pin) cmd_set_pin ;;
  recompute) cmd_recompute ;;
  db-snapshot) cmd_db_snapshot ;;
  restore) cmd_restore ;;
  export) cmd_export ;;
  *) echo "usage: ./meowtower up|down|status|ipad-setup|set-home-network|watch|pair|set-pin|recompute|db-snapshot|restore|export" >&2; exit 2 ;;
esac
