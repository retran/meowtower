# Copy this file to .env and fill it in. .env stays on the Mac: git ignores it, and
# compose.yaml hands it to the meowtower service alone. The server reads it only at
# start, so restart after a change: docker compose restart meowtower

# --- Keys. Set only the keys of the routes your roles name below. --------------------

# The OpenRouter play key. Jev always goes through it, so this key is required. In
# OpenRouter, set its limit to 200 dollars with a monthly reset, forbid storage and
# training on the account, and allow only the providers listed under the tiers below,
# with TypeSafe among them.
OPENROUTER_PLAY_KEY=

# The direct Anthropic route, needed only if a role below names anthropic. Create the
# key in the Claude Console and set a monthly workspace limit there too, because the
# game's own count is the only other limit on this route.
ANTHROPIC_API_KEY=

# The offline key, which `npm run verify:live` spends from. It is never the play key.
OPENROUTER_OFFLINE_KEY=

# --- Model roles. Each value is <route>:<model>, and the route is openrouter or -------
# --- anthropic. Live frames stay off until both roles are set, and tasks then show ---
# --- their template text. A frame takes 2 calls, one to each role. --------------------

# Writes 5 story variants around each task. Its requests hold no player material.
TASK_TEXT_MODEL=anthropic:claude-haiku-5-5

# Jev. One request checks every variant for safety, jokes and whether it still asks
# what the task asks, then chooses the best. If it fails, the task shows template text.
FRAME_JUDGE_MODEL=openrouter:typesafe/jev-1.14

# --- Providers on OpenRouter. These are the defaults; leave them unset to keep them. --
# An entry slug:prefix counts only for models with that prefix, such as
# mistral:z-ai/glm-

# PLAYER_TIER_PROVIDERS=google-vertex,amazon-bedrock,azure,xai
# CONTENT_TIER_PROVIDERS=anthropic,openai,google-ai-studio,seed,mistral

# A player-tier role may name the anthropic route only with this set to true. No role
# needs it yet. Setting it states that your organisation has Anthropic's zero data
# retention by contract, and no interface can check that.
ANTHROPIC_ZDR_ATTESTED=false

# --- Privacy. -------------------------------------------------------------------------

# Names the egress guard replaces with a neutral label before a request leaves the Mac,
# separated by commas: the player's real name, family names, the school, the street and
# the city.
MEOWTOWER_EGRESS_NAMES=

# --- The game. ------------------------------------------------------------------------

# The family's time zone, which sets where a game day ends.
MEOWTOWER_ZONE=Europe/Amsterdam

# --- Tools only. The server runs only in play, so leave this unset here. --------------
# npm run verify:live sets GATEWAY_MODE=verify itself and records under tests/recordings/.
# VERIFY_LIVE_BUDGET_USD=2
