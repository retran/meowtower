# Copy this file to .env and fill it in. .env stays on the Mac: git ignores it, and
# compose.yaml hands it to the meowtower service alone. The server reads it only at
# start, so restart after a change: docker compose restart meowtower

# --- Keys. Set only the keys of the routes your roles name below. --------------------

# The direct Anthropic route. Create the key in the Claude Console. Set a monthly
# workspace limit there too, because the game's own count is the only other limit on
# this route.
ANTHROPIC_API_KEY=

# The OpenRouter play key. In OpenRouter, set this key's limit to 200 dollars with a
# monthly reset, forbid storage and training on the account, and allow only the
# providers listed under the tiers below.
OPENROUTER_PLAY_KEY=

# The offline key, which `npm run verify:live` spends from. It is never the play key.
OPENROUTER_OFFLINE_KEY=

# --- Model roles. Each value is <route>:<model>, and the route is openrouter or -------
# --- anthropic. Each kind of work can use its own model and provider. Live frames ----
# --- stay off until all three roles are set, and tasks then show template text. ------

# Writes the story frame around each task. Its requests hold no player material.
TASK_TEXT_MODEL=anthropic:claude-haiku-5-5

# Solves each frame blind, three times. This role is in the player tier.
# Check the model id against OpenRouter's catalogue: a model missing from its route
# stops the server at start, and the message names the role.
LIVE_CHECK_MODEL=openrouter:anthropic/claude-haiku-5-5

# Reads each frame for safety. This role is in the player tier.
SAFETY_MODEL=openrouter:anthropic/claude-haiku-5-5

# A player-tier role may name the anthropic route only with this set to true. Setting
# it states that your organisation has Anthropic's zero data retention by contract,
# which you get through Anthropic's sales team. No interface can check it, so leave it
# false unless the contract exists. Even then Anthropic may keep a flagged session for
# up to 2 years.
ANTHROPIC_ZDR_ATTESTED=false

# --- Providers on OpenRouter. These are the defaults; leave them unset to keep them. --
# An entry slug:prefix counts only for models with that prefix, such as
# mistral:z-ai/glm-

# PLAYER_TIER_PROVIDERS=google-vertex,amazon-bedrock,azure,xai
# CONTENT_TIER_PROVIDERS=anthropic,openai,google-ai-studio,seed,mistral

# --- Privacy. -------------------------------------------------------------------------

# Names the egress guard replaces with a neutral label before a request leaves the Mac,
# separated by commas: the player's real name, family names, the school, the street and
# the city.
MEOWTOWER_EGRESS_NAMES=

# --- The game. ------------------------------------------------------------------------

# The family's time zone, which sets where a game day ends.
MEOWTOWER_ZONE=Europe/Amsterdam

# --- Tools only. The server runs only in play, so leave this unset here. --------------
# npm run verify:live sets GATEWAY_MODE=verify itself and records under tests/recordings/.
# VERIFY_LIVE_BUDGET_USD=2
