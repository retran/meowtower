# Copy this file to .env and fill it in. .env stays on the Mac: git ignores it, and
# compose.yaml hands it to the meowtower service alone. The server reads it only when
# the container is created, so after a change run: docker compose up -d --force-recreate meowtower

# --- Keys. Set only the keys of the routes your roles name below. --------------------

# The direct Anthropic route. Create the key in the Claude Console. Set a monthly
# workspace limit there too, because the game's own count is the only other limit on
# this route.
ANTHROPIC_API_KEY=

# The OpenRouter play key, needed only if a role below names openrouter. In OpenRouter,
# set this key's limit to 200 dollars with a monthly reset, forbid storage and training
# on the account, and allow only the providers listed under the tiers below.
OPENROUTER_PLAY_KEY=

# The offline key, which `npm run verify:live` spends from on the openrouter route.
# It is never the play key.
OPENROUTER_OFFLINE_KEY=

# --- Model roles. Each value is <route>:<model>, and the route is openrouter or -------
# --- anthropic. Each kind of work can use its own model and provider. Live stories ---
# --- stay off until both roles are set, and tasks then show template text. ------------

# Writes the story around each task, at low effort. Its requests hold no player
# material, apart from the player's gender and the fact that a first attempt failed.
TASK_TEXT_MODEL=anthropic:claude-sonnet-5-5

# Solves each story from its own text and scores it. The engine checks the answer.
# A story that fails or scores below the bar is written again, up to 3 times.
FRAME_JUDGE_MODEL=anthropic:claude-haiku-5-5

# Plans, writes, critiques and revises each adventure's scenario, one role for the whole
# loop. Optional: unset, the game plays without scenarios. Its requests hold no player
# material yet.
SHOWRUNNER_MODEL=anthropic:claude-sonnet-5-5

# --- Providers on OpenRouter. These are the defaults; leave them unset to keep them. --
# An entry slug:prefix counts only for models with that prefix, such as
# mistral:z-ai/glm-

# PLAYER_TIER_PROVIDERS=google-vertex,amazon-bedrock,azure,xai
# CONTENT_TIER_PROVIDERS=anthropic,openai,google-ai-studio,seed,mistral

# A player-tier role may name the anthropic route only with this set to true. No role
# needs it yet. Setting it states that your organisation has Anthropic's zero data
# retention by contract, and no interface can check that.
ANTHROPIC_ZDR_ATTESTED=false

# --- Privacy. -------------------------------------------------------------------------

# Names the egress guard replaces with a neutral label before a request leaves the Mac,
# separated by commas: the player's real name, family names, the school, the street and
# the city.
MEOWTOWER_EGRESS_NAMES=

# --- The game. ------------------------------------------------------------------------

# The family's time zone, which sets where a game day ends.
MEOWTOWER_ZONE=Europe/Amsterdam

# --- Tools only. The server runs only in play, so leave this unset here. --------------
# npm run verify:live sets GATEWAY_MODE=verify itself and records under tests/recordings/.
# VERIFY_LIVE_BUDGET_USD=2
